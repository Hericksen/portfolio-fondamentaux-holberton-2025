{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API pour la plateforme de gamification PixelPump.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "seed": "node seeds/seed.js",
    "db:reset": "node seeds/seed.js",
    "users:reset": "node scripts/resetAllUsers.js",
    "maintenance": "node scripts/maintenance.js",
    "create-quests": "node scripts/createAdvancedQuests.js",
    "update-role": "node scripts/updateRole.js",
    "clean": "find . -path './node_modules' -prune -o \\( -name '*.clean.*' -o -name '*.test.*' -o -name '*.working.*' -o -name '*.fixed.*' -o -name '*.new.*' -o -name '*.simple.*' -o -name '*.tmp' -o -name '*.temp' -o -name '*.bak' -o -name '*.old' -o -name '*~' \\) -exec rm -f {} \\;"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "node-cron": "^3.0.3",
    "pg": "^8.16.2",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "jest": "^30.0.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1"
  }
}
