# Global gitignore for PixelPump portfolio project

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
out/
**/dist/
**/build/
**/out/

# Environment files
.env
.env.local
.env.test
.env.production
**/.env*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage and testing
coverage/
.coverage
.nyc_output
test-results/
junit.xml

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-*
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.cache

# Development and test files
*.test.*
*.working.*
*.fixed.*
*.clean.*
*.new.*
*.simple.*
*.dev.*
*.debug.*

# Database
*.db
*.sqlite
*.sqlite3

# Certificates and keys
*.pem
*.key
*.crt
*.cert

# Archive files
*.zip
*.tar.gz
*.rar
*.7z
